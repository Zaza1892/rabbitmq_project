# Dockerfile.mockapi
#
# Builds the container for mock_api.py, the pretend tenant-lookup API
# used for local testing and development. Standing in for a real
# tenant-lookup service that either doesn't exist yet or isn't
# accessible during development.


FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY mock_api.py .

CMD ["uvicorn", "mock_api:app","--host","0.0.0.0","--port","8000"]






